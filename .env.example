# Supabase project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# Server-only secret key. Never expose in VITE_* variables or client code.
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-secret

# CLOVA Speech short-form recognition invoke URL
CLOVA_SPEECH_INVOKE_URL=https://clovaspeech-gw.ncloud.com/recognizer/upload

# Server-only CLOVA Speech secret
CLOVA_SPEECH_SECRET=replace-with-clova-secret
